# Origin of the OutreachOS backend (the `outbound` repo's apps/web deployment).
# app/api/[...path]/route.ts forwards every `/api/*` request to this host, which
# keeps the session cookie first-party and avoids any CORS setup.
#
# Read at RUNTIME. On Cloudflare it must be a Worker variable or secret — a
# build-only variable is not visible to the running Worker. Prefer a secret, as
# `wrangler deploy` overwrites dashboard-set plain-text vars from wrangler.jsonc.
API_ORIGIN=https://api.example.com

# Only set this if you want the browser to call the backend directly instead of
# going through the rewrite above. Requires the backend to allow this origin with
# credentials (see CORS_ALLOWED_ORIGINS in the `outbound` repo).
# NEXT_PUBLIC_API_BASE_URL=

# Public URL this frontend is served from. Used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only when targeting a Node server or container (emits
# .next/standalone). Leave unset for Cloudflare — the adapter builds its own
# bundle from the default .next output.
# NEXT_STANDALONE=true
